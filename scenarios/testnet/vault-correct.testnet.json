{
  "scenarioVersion": 1,
  "name": "vault-correct-testnet",
  "description": "The corrected-path rehearsal for Stellar testnet: deploy v1, seed, upgrade, migrate, verify through RPC reads. Omits raw-storage probes and the signing-key attack operations, which testnet mode cannot evaluate (see README).",
  "wasm": {
    "old": "fixtures/wasm/vault_v1.wasm",
    "new": "fixtures/wasm/vault_v2_correct.wasm"
  },
  "accounts": [
    "admin",
    "alice",
    "bob",
    "carol",
    "dave",
    "mallory"
  ],
  "ops": [
    {
      "id": "s-init",
      "phase": "seed",
      "fn": "initialize",
      "args": [
        {
          "name": "admin",
          "account": "admin"
        }
      ],
      "auth": [
        "admin"
      ]
    },
    {
      "id": "s-alice-1",
      "phase": "seed",
      "fn": "deposit",
      "args": [
        {
          "name": "from",
          "account": "alice"
        },
        {
          "name": "amount",
          "i128": "100"
        }
      ],
      "auth": [
        "alice"
      ]
    },
    {
      "id": "s-bob",
      "phase": "seed",
      "fn": "deposit",
      "args": [
        {
          "name": "from",
          "account": "bob"
        },
        {
          "name": "amount",
          "i128": "250"
        }
      ],
      "auth": [
        "bob"
      ]
    },
    {
      "id": "s-carol",
      "phase": "seed",
      "fn": "deposit",
      "args": [
        {
          "name": "from",
          "account": "carol"
        },
        {
          "name": "amount",
          "i128": "75"
        }
      ],
      "auth": [
        "carol"
      ]
    },
    {
      "id": "s-dave",
      "phase": "seed",
      "fn": "deposit",
      "args": [
        {
          "name": "from",
          "account": "dave"
        },
        {
          "name": "amount",
          "i128": "40"
        }
      ],
      "auth": [
        "dave"
      ]
    },
    {
      "id": "s-alice-2",
      "phase": "seed",
      "fn": "deposit",
      "args": [
        {
          "name": "from",
          "account": "alice"
        },
        {
          "name": "amount",
          "i128": "25"
        }
      ],
      "auth": [
        "alice"
      ]
    },
    {
      "id": "upgrade",
      "phase": "upgrade",
      "fn": "upgrade",
      "args": [
        {
          "name": "new_wasm_hash",
          "wasmHash": "new"
        }
      ],
      "auth": [
        "admin"
      ],
      "upgrade": true,
      "note": "The real upgrade: the admin signs the call; the contract calls update_current_contract_wasm."
    },
    {
      "id": "p-alice-deposit",
      "phase": "postUpgrade",
      "fn": "deposit",
      "args": [
        {
          "name": "from",
          "account": "alice"
        },
        {
          "name": "amount",
          "i128": "50"
        }
      ],
      "auth": [
        "alice"
      ]
    },
    {
      "id": "p-migrate-partial",
      "phase": "postUpgrade",
      "fn": "migrate",
      "args": [
        {
          "name": "limit",
          "u32": 2
        }
      ],
      "auth": [
        "admin"
      ],
      "note": "Batched migration: convert at most 2 legacy balances."
    },
    {
      "id": "p-migrate-rest",
      "phase": "postUpgrade",
      "fn": "migrate",
      "args": [
        {
          "name": "limit",
          "u32": 10
        }
      ],
      "auth": [
        "admin"
      ]
    },
    {
      "id": "p-migrate-again",
      "phase": "postUpgrade",
      "fn": "migrate",
      "args": [
        {
          "name": "limit",
          "u32": 10
        }
      ],
      "auth": [
        "admin"
      ],
      "note": "Repeated migration call: must change nothing."
    },
    {
      "id": "attack-reinit",
      "phase": "postUpgrade",
      "fn": "initialize",
      "args": [
        {
          "name": "admin",
          "account": "mallory"
        }
      ],
      "auth": [
        "mallory"
      ],
      "expect": "error",
      "note": "Repeated initialization by a stranger who authorizes her own call."
    }
  ],
  "probes": [
    {
      "kind": "call",
      "id": "balance-alice",
      "fn": "balance",
      "args": [
        {
          "name": "who",
          "account": "alice"
        }
      ]
    },
    {
      "kind": "call",
      "id": "balance-bob",
      "fn": "balance",
      "args": [
        {
          "name": "who",
          "account": "bob"
        }
      ]
    },
    {
      "kind": "call",
      "id": "balance-carol",
      "fn": "balance",
      "args": [
        {
          "name": "who",
          "account": "carol"
        }
      ]
    },
    {
      "kind": "call",
      "id": "balance-dave",
      "fn": "balance",
      "args": [
        {
          "name": "who",
          "account": "dave"
        }
      ]
    },
    {
      "kind": "call",
      "id": "total-supply",
      "fn": "total_supply",
      "args": []
    },
    {
      "kind": "call",
      "id": "admin",
      "fn": "admin",
      "args": []
    },
    {
      "kind": "call",
      "id": "holders",
      "fn": "holders",
      "args": []
    }
  ],
  "invariants": [
    {
      "kind": "preserved",
      "id": "balances-preserved-across-upgrade",
      "title": "Every seeded balance, the total supply and the holder list are identical immediately before and after the upgrade",
      "from": "before:upgrade",
      "to": "after:upgrade",
      "probes": [
        "balance-alice",
        "balance-bob",
        "balance-carol",
        "balance-dave",
        "total-supply",
        "holders"
      ]
    },
    {
      "kind": "preserved",
      "id": "admin-unchanged-across-upgrade",
      "title": "The admin address is unchanged by the upgrade",
      "from": "before:upgrade",
      "to": "after:upgrade",
      "probes": [
        "admin"
      ]
    },
    {
      "kind": "sumEquals",
      "id": "supply-equals-sum-after-upgrade",
      "title": "Total supply equals the sum of balances right after the upgrade",
      "at": "after:upgrade",
      "parts": [
        "balance-alice",
        "balance-bob",
        "balance-carol",
        "balance-dave"
      ],
      "total": "total-supply"
    },
    {
      "kind": "expectedValues",
      "id": "mixed-format-balances-correct",
      "title": "With old and new entries side by side, every balance reads back as the seed operations imply",
      "at": "after:p-alice-deposit",
      "expect": {
        "balance-alice": "175",
        "balance-bob": "250",
        "balance-carol": "75",
        "balance-dave": "40",
        "total-supply": "540"
      }
    },
    {
      "kind": "expectedValues",
      "id": "partial-migration-preserves-balances",
      "title": "After a partial (batched) migration every balance is still correct",
      "at": "after:p-migrate-partial",
      "expect": {
        "balance-alice": "175",
        "balance-bob": "250",
        "balance-carol": "75",
        "balance-dave": "40",
        "total-supply": "540"
      }
    },
    {
      "kind": "expectedValues",
      "id": "seeded-balances-preserved-after-migration",
      "title": "After the migration every seeded balance equals the value the seed operations imply",
      "at": "after:p-migrate-rest",
      "expect": {
        "balance-alice": "175",
        "balance-bob": "250",
        "balance-carol": "75",
        "balance-dave": "40",
        "total-supply": "540"
      }
    },
    {
      "kind": "sumEquals",
      "id": "supply-equals-sum-after-migration",
      "title": "Total supply equals the sum of balances after the migration",
      "at": "after:p-migrate-rest",
      "parts": [
        "balance-alice",
        "balance-bob",
        "balance-carol",
        "balance-dave"
      ],
      "total": "total-supply"
    },
    {
      "kind": "preserved",
      "id": "admin-unchanged-after-migration",
      "title": "The admin address is unchanged after the whole upgrade and migration",
      "from": "before:upgrade",
      "to": "after:p-migrate-rest",
      "probes": [
        "admin"
      ]
    },
    {
      "kind": "stableAcrossOp",
      "id": "migration-idempotent",
      "title": "Calling migrate again changes nothing (balances, supply, admin, holders and raw storage)",
      "op": "p-migrate-again",
      "probes": [
        "balance-alice",
        "balance-bob",
        "balance-carol",
        "balance-dave",
        "total-supply",
        "admin",
        "holders"
      ]
    },
    {
      "kind": "opRejected",
      "id": "reinitialize-rejected",
      "title": "A repeated initialize by a stranger is rejected by the contract",
      "op": "attack-reinit",
      "class": "contract"
    },
    {
      "kind": "stableAcrossOp",
      "id": "reinitialize-changes-nothing",
      "title": "A repeated initialize leaves admin, supply, holders and balances untouched",
      "op": "attack-reinit",
      "probes": [
        "balance-alice",
        "balance-bob",
        "balance-carol",
        "balance-dave",
        "total-supply",
        "admin",
        "holders"
      ]
    }
  ]
}
