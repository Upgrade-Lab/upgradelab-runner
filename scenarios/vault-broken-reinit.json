{
  "scenarioVersion": 1,
  "name": "vault-broken-reinit",
  "description": "Broken v2: initialize lost its already-initialized guard, so a stranger can take over and wipe the accounting. Seeded on vault v1, upgraded with update_current_contract_wasm, then migrated.",
  "wasm": {
    "old": "fixtures/wasm/vault_v1.wasm",
    "new": "fixtures/wasm/vault_v2_broken_reinit.wasm"
  },
  "accounts": [
    "admin",
    "alice",
    "bob",
    "carol",
    "dave",
    "mallory"
  ],
  "ops": [
    {
      "id": "s-init",
      "phase": "seed",
      "fn": "initialize",
      "args": [
        {
          "name": "admin",
          "account": "admin"
        }
      ],
      "auth": [
        "admin"
      ]
    },
    {
      "id": "s-alice-1",
      "phase": "seed",
      "fn": "deposit",
      "args": [
        {
          "name": "from",
          "account": "alice"
        },
        {
          "name": "amount",
          "i128": "100"
        }
      ],
      "auth": [
        "alice"
      ]
    },
    {
      "id": "s-bob",
      "phase": "seed",
      "fn": "deposit",
      "args": [
        {
          "name": "from",
          "account": "bob"
        },
        {
          "name": "amount",
          "i128": "250"
        }
      ],
      "auth": [
        "bob"
      ]
    },
    {
      "id": "s-carol",
      "phase": "seed",
      "fn": "deposit",
      "args": [
        {
          "name": "from",
          "account": "carol"
        },
        {
          "name": "amount",
          "i128": "75"
        }
      ],
      "auth": [
        "carol"
      ]
    },
    {
      "id": "s-dave",
      "phase": "seed",
      "fn": "deposit",
      "args": [
        {
          "name": "from",
          "account": "dave"
        },
        {
          "name": "amount",
          "i128": "40"
        }
      ],
      "auth": [
        "dave"
      ]
    },
    {
      "id": "s-alice-2",
      "phase": "seed",
      "fn": "deposit",
      "args": [
        {
          "name": "from",
          "account": "alice"
        },
        {
          "name": "amount",
          "i128": "25"
        }
      ],
      "auth": [
        "alice"
      ]
    },
    {
      "id": "attack-old-no-auth",
      "phase": "seed",
      "fn": "upgrade",
      "args": [
        {
          "name": "new_wasm_hash",
          "wasmHash": "new"
        }
      ],
      "auth": [],
      "expect": "error",
      "note": "Attack on the OLD contract: anyone calls upgrade with no authorization. Must be rejected by the host."
    },
    {
      "id": "upgrade",
      "phase": "upgrade",
      "fn": "upgrade",
      "args": [
        {
          "name": "new_wasm_hash",
          "wasmHash": "new"
        }
      ],
      "auth": [
        "admin"
      ],
      "upgrade": true,
      "note": "The real upgrade: the admin signs the call; the contract calls update_current_contract_wasm."
    },
    {
      "id": "p-alice-deposit",
      "phase": "postUpgrade",
      "fn": "deposit",
      "args": [
        {
          "name": "from",
          "account": "alice"
        },
        {
          "name": "amount",
          "i128": "50"
        }
      ],
      "auth": [
        "alice"
      ]
    },
    {
      "id": "p-migrate-partial",
      "phase": "postUpgrade",
      "fn": "migrate",
      "args": [
        {
          "name": "limit",
          "u32": 2
        }
      ],
      "auth": [
        "admin"
      ],
      "note": "Batched migration: convert at most 2 legacy balances."
    },
    {
      "id": "p-migrate-rest",
      "phase": "postUpgrade",
      "fn": "migrate",
      "args": [
        {
          "name": "limit",
          "u32": 10
        }
      ],
      "auth": [
        "admin"
      ]
    },
    {
      "id": "p-migrate-again",
      "phase": "postUpgrade",
      "fn": "migrate",
      "args": [
        {
          "name": "limit",
          "u32": 10
        }
      ],
      "auth": [
        "admin"
      ],
      "note": "Repeated migration call: must change nothing."
    },
    {
      "id": "attack-upgrade-no-auth",
      "phase": "postUpgrade",
      "fn": "upgrade",
      "args": [
        {
          "name": "new_wasm_hash",
          "wasmHash": "old"
        }
      ],
      "auth": [],
      "expect": "error",
      "note": "Attack on the NEW contract: no authorization at all, tries to roll the code back."
    },
    {
      "id": "attack-upgrade-self-auth",
      "phase": "postUpgrade",
      "fn": "upgrade",
      "args": [
        {
          "name": "new_wasm_hash",
          "wasmHash": "old"
        }
      ],
      "auth": [
        "mallory"
      ],
      "expect": "error",
      "note": "Attack on the NEW contract: mallory signs a valid authorization for herself, which is not the admin."
    },
    {
      "id": "attack-reinit",
      "phase": "postUpgrade",
      "fn": "initialize",
      "args": [
        {
          "name": "admin",
          "account": "mallory"
        }
      ],
      "auth": [
        "mallory"
      ],
      "expect": "error",
      "note": "Repeated initialization by a stranger who authorizes her own call."
    }
  ],
  "probes": [
    {
      "kind": "call",
      "id": "balance-alice",
      "fn": "balance",
      "args": [
        {
          "name": "who",
          "account": "alice"
        }
      ]
    },
    {
      "kind": "call",
      "id": "balance-bob",
      "fn": "balance",
      "args": [
        {
          "name": "who",
          "account": "bob"
        }
      ]
    },
    {
      "kind": "call",
      "id": "balance-carol",
      "fn": "balance",
      "args": [
        {
          "name": "who",
          "account": "carol"
        }
      ]
    },
    {
      "kind": "call",
      "id": "balance-dave",
      "fn": "balance",
      "args": [
        {
          "name": "who",
          "account": "dave"
        }
      ]
    },
    {
      "kind": "call",
      "id": "total-supply",
      "fn": "total_supply",
      "args": []
    },
    {
      "kind": "call",
      "id": "admin",
      "fn": "admin",
      "args": []
    },
    {
      "kind": "call",
      "id": "holders",
      "fn": "holders",
      "args": []
    },
    {
      "kind": "storage",
      "id": "raw-legacy-alice",
      "durability": "persistent",
      "key": {
        "variant": {
          "name": "Balance",
          "values": [
            {
              "account": "alice"
            }
          ]
        }
      }
    },
    {
      "kind": "storage",
      "id": "raw-legacy-bob",
      "durability": "persistent",
      "key": {
        "variant": {
          "name": "Balance",
          "values": [
            {
              "account": "bob"
            }
          ]
        }
      }
    },
    {
      "kind": "storage",
      "id": "raw-legacy-carol",
      "durability": "persistent",
      "key": {
        "variant": {
          "name": "Balance",
          "values": [
            {
              "account": "carol"
            }
          ]
        }
      }
    },
    {
      "kind": "storage",
      "id": "raw-legacy-dave",
      "durability": "persistent",
      "key": {
        "variant": {
          "name": "Balance",
          "values": [
            {
              "account": "dave"
            }
          ]
        }
      }
    },
    {
      "kind": "storage",
      "id": "raw-v2-alice",
      "durability": "persistent",
      "key": {
        "variant": {
          "name": "BalanceV2",
          "values": [
            {
              "account": "alice"
            }
          ]
        }
      }
    },
    {
      "kind": "storage",
      "id": "raw-v2-bob",
      "durability": "persistent",
      "key": {
        "variant": {
          "name": "BalanceV2",
          "values": [
            {
              "account": "bob"
            }
          ]
        }
      }
    },
    {
      "kind": "storage",
      "id": "raw-v2-carol",
      "durability": "persistent",
      "key": {
        "variant": {
          "name": "BalanceV2",
          "values": [
            {
              "account": "carol"
            }
          ]
        }
      }
    },
    {
      "kind": "storage",
      "id": "raw-v2-dave",
      "durability": "persistent",
      "key": {
        "variant": {
          "name": "BalanceV2",
          "values": [
            {
              "account": "dave"
            }
          ]
        }
      }
    }
  ],
  "invariants": [
    {
      "kind": "preserved",
      "id": "balances-preserved-across-upgrade",
      "title": "Every seeded balance, the total supply and the holder list are identical immediately before and after the upgrade",
      "from": "before:upgrade",
      "to": "after:upgrade",
      "probes": [
        "balance-alice",
        "balance-bob",
        "balance-carol",
        "balance-dave",
        "total-supply",
        "holders"
      ]
    },
    {
      "kind": "preserved",
      "id": "admin-unchanged-across-upgrade",
      "title": "The admin address is unchanged by the upgrade",
      "from": "before:upgrade",
      "to": "after:upgrade",
      "probes": [
        "admin"
      ]
    },
    {
      "kind": "sumEquals",
      "id": "supply-equals-sum-after-upgrade",
      "title": "Total supply equals the sum of balances right after the upgrade",
      "at": "after:upgrade",
      "parts": [
        "balance-alice",
        "balance-bob",
        "balance-carol",
        "balance-dave"
      ],
      "total": "total-supply"
    },
    {
      "kind": "shapes",
      "id": "mixed-format-state-exercised",
      "title": "Mixed-format state is really present: alice (touched after the upgrade) is in the new format, the others are still in the old format",
      "at": "after:p-alice-deposit",
      "expect": {
        "raw-v2-alice": "map",
        "raw-legacy-alice": "absent",
        "raw-legacy-bob": "i128",
        "raw-v2-bob": "absent",
        "raw-legacy-carol": "i128",
        "raw-v2-carol": "absent",
        "raw-legacy-dave": "i128",
        "raw-v2-dave": "absent"
      }
    },
    {
      "kind": "expectedValues",
      "id": "mixed-format-balances-correct",
      "title": "With old and new entries side by side, every balance reads back as the seed operations imply",
      "at": "after:p-alice-deposit",
      "expect": {
        "balance-alice": "175",
        "balance-bob": "250",
        "balance-carol": "75",
        "balance-dave": "40",
        "total-supply": "540"
      }
    },
    {
      "kind": "expectedValues",
      "id": "partial-migration-preserves-balances",
      "title": "After a partial (batched) migration every balance is still correct",
      "at": "after:p-migrate-partial",
      "expect": {
        "balance-alice": "175",
        "balance-bob": "250",
        "balance-carol": "75",
        "balance-dave": "40",
        "total-supply": "540"
      }
    },
    {
      "kind": "expectedValues",
      "id": "seeded-balances-preserved-after-migration",
      "title": "After the migration every seeded balance equals the value the seed operations imply",
      "at": "after:p-migrate-rest",
      "expect": {
        "balance-alice": "175",
        "balance-bob": "250",
        "balance-carol": "75",
        "balance-dave": "40",
        "total-supply": "540"
      }
    },
    {
      "kind": "sumEquals",
      "id": "supply-equals-sum-after-migration",
      "title": "Total supply equals the sum of balances after the migration",
      "at": "after:p-migrate-rest",
      "parts": [
        "balance-alice",
        "balance-bob",
        "balance-carol",
        "balance-dave"
      ],
      "total": "total-supply"
    },
    {
      "kind": "preserved",
      "id": "admin-unchanged-after-migration",
      "title": "The admin address is unchanged after the whole upgrade and migration",
      "from": "before:upgrade",
      "to": "after:p-migrate-rest",
      "probes": [
        "admin"
      ]
    },
    {
      "kind": "shapes",
      "id": "migration-converts-every-entry",
      "title": "After the migration no legacy entry remains and every holder has a new-format entry",
      "at": "after:p-migrate-rest",
      "expect": {
        "raw-legacy-alice": "absent",
        "raw-legacy-bob": "absent",
        "raw-legacy-carol": "absent",
        "raw-legacy-dave": "absent",
        "raw-v2-alice": "map",
        "raw-v2-bob": "map",
        "raw-v2-carol": "map",
        "raw-v2-dave": "map"
      }
    },
    {
      "kind": "stableAcrossOp",
      "id": "migration-idempotent",
      "title": "Calling migrate again changes nothing (balances, supply, admin, holders and raw storage)",
      "op": "p-migrate-again",
      "probes": [
        "balance-alice",
        "balance-bob",
        "balance-carol",
        "balance-dave",
        "total-supply",
        "admin",
        "holders",
        "raw-legacy-alice",
        "raw-legacy-bob",
        "raw-legacy-carol",
        "raw-legacy-dave",
        "raw-v2-alice",
        "raw-v2-bob",
        "raw-v2-carol",
        "raw-v2-dave"
      ]
    },
    {
      "kind": "opRejected",
      "id": "unauthorized-upgrade-rejected-old-contract",
      "title": "An unauthenticated upgrade of the old contract is rejected and the executable is unchanged",
      "op": "attack-old-no-auth",
      "class": "auth"
    },
    {
      "kind": "opRejected",
      "id": "unauthorized-upgrade-rejected-no-auth",
      "title": "An unauthenticated upgrade of the new contract is rejected and the executable is unchanged",
      "op": "attack-upgrade-no-auth",
      "class": "auth"
    },
    {
      "kind": "opRejected",
      "id": "unauthorized-upgrade-rejected-self-signed",
      "title": "An upgrade signed by a non-admin account is rejected and the executable is unchanged",
      "op": "attack-upgrade-self-auth",
      "class": "auth"
    },
    {
      "kind": "opRejected",
      "id": "reinitialize-rejected",
      "title": "A repeated initialize by a stranger is rejected by the contract",
      "op": "attack-reinit",
      "class": "contract"
    },
    {
      "kind": "stableAcrossOp",
      "id": "reinitialize-changes-nothing",
      "title": "A repeated initialize leaves admin, supply, holders and balances untouched",
      "op": "attack-reinit",
      "probes": [
        "balance-alice",
        "balance-bob",
        "balance-carol",
        "balance-dave",
        "total-supply",
        "admin",
        "holders",
        "raw-legacy-alice",
        "raw-legacy-bob",
        "raw-legacy-carol",
        "raw-legacy-dave",
        "raw-v2-alice",
        "raw-v2-bob",
        "raw-v2-carol",
        "raw-v2-dave"
      ]
    }
  ]
}
